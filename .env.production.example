# ------------------------------------------------------------------
# Online Classroom — PRODUCTION environment
#
# None of this is required to boot: with an empty environment the app generates
# its own SECRET_KEY, accepts any Host header, treats itself as HTTP, and uses
# SQLite. That is a legal test deployment (`deploy.W012`/`W013`/`W003` say so in
# the log). Copy this file when you want a real domain: it is the short list of
# decisions only you can make.
#
#   cp .env.production.example .env
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# The step-by-step guide is deploy/DEPLOY.md.
# ------------------------------------------------------------------

# --- Strongly recommended -------------------------------------------
# Random, long, secret. Left empty the app generates one and keeps it in
# `private_media/.secret_key` (0600) — stable across restarts, and never the
# public development key.
# SECRET_KEY=

# Always false on a server.  Booting with DEBUG=false and nothing else is
# supported; this is what stops the traceback page from being public.
DEBUG=false

# The domain(s) the site is opened on, comma separated, no wildcard, no scheme.
# Leave empty to accept any Host header (the app reports deploy.W012 when it
# does). Naming the domain is what closes that.
#   ALLOWED_HOSTS=class.example.com,www.class.example.com
# Setting PUBLIC_URL to the deployed address adds it automatically.
ALLOWED_HOSTS=

# Exactly the browser origins that POST to the app (scheme + host):
#   CSRF_TRUSTED_ORIGINS=https://class.example.com
# Not needed when TRUST_X_FORWARDED_PROTO is on (the default) and the proxy
# forwards the real scheme.
CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------
# PostgreSQL (recommended). On Weblines: link the database to the app and this
# is injected automatically — leave it empty only if you have no database.
#   DATABASE_URL=postgres://user:password@host:5432/dbname
# Credentials may be percent-encoded (p%40ss for p@ss) and the query string is
# honoured: a hosted database's own requirements now reach the driver.
#   DATABASE_URL=postgres://u:p@host:5432/db?sslmode=require&connect_timeout=5
DATABASE_URL=
# Reuse database connections (0 = open one per request). Managed/pooled
# PostgreSQL usually wants 0–60; a long-lived VPS benefits from 60.
# DB_CONN_MAX_AGE=0
# Only for a transaction-pooling pgbouncer (server-side cursors break there).
# DB_DISABLE_SERVER_SIDE_CURSORS=false

# --- Redis / queue --------------------------------------------------
# One URL for channel layer + cache + Celery broker + result backend.
# Empty means "single process": realtime stays inside one worker and
# background jobs run inline (fine for a small install, never for several
# processes). On Weblines: create a Redis service and paste its private address.
#   REDIS_URL=redis://default:PASSWORD@redis-host:6379/0
REDIS_URL=

# Uncomment only to force inline execution even though Redis is set.
# CELERY_TASK_ALWAYS_EAGER=true

# --- Storage (containers: use a persistent volume!) -----------------
# Anything the app writes disappears with the next deploy unless it lives on a
# volume. Mount one at /data and point both paths into it.
#   MEDIA_ROOT=/data/media
#   PRIVATE_MEDIA_ROOT=/data/private_media        (classroom files — never public)
MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=
# STATIC_ROOT: leave EMPTY on a container platform — the image already contains
# the collected files (/app/staticfiles) and WhiteNoise serves them from there.
# Setting it to a path that was never collected is the classic "no CSS" deploy.
STATIC_ROOT=

# --- Media server (optional) ----------------------------------------
# Empty means "no SFU": the room falls back to the P2P mesh (max
# MESH_MAX_PARTICIPANTS). For real classes, run LiveKit and fill these in.
MEDIA_SERVER_URL=
MEDIA_SERVER_API_KEY=
MEDIA_SERVER_API_SECRET=
MEDIA_TOKEN_TTL_MINUTES=120

# TURN relay for the mesh fallback (coturn), JSON list:
#   WEBRTC_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478?transport=udp"],"username":"classroom","credential":"..."}]
WEBRTC_ICE_SERVERS=
MESH_MAX_PARTICIPANTS=12

# --- Files ----------------------------------------------------------
MAX_UPLOAD_MB=25
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW=600
# LibreOffice conversion timeout, seconds (only if LibreOffice is installed).
OFFICE_CONVERT_TIMEOUT=90

# --- Housekeeping (celery beat, or `manage.py housekeeping` from cron) ---
STALE_SESSION_HOURS=8
GUEST_RETENTION_DAYS=7
PRUNE_BOARD_DAYS=90
PRUNE_CHAT_DAYS=0

# --- Email (password reset) -----------------------------------------
EMAIL_BACKEND=console
# For a real server:
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Behind a reverse proxy / platform edge -------------------------
# TLS terminates at the proxy, which forwards plain HTTP with
# X-Forwarded-Proto: https. Required for CSRF to accept https Origins.
# Default is already true; listed for clarity.
TRUST_X_FORWARDED_PROTO=true

# Says "this deployment is served over TLS". One value, and Secure cookies,
# the HTTP→HTTPS redirect and HSTS all turn on. Default: true when PUBLIC_URL
# is https, false otherwise — which is why a bare http://server:8000 works.
HTTPS_IN_USE=true
# Django also needs this when the proxy does not pass the original scheme.
# SECURE_PROXY_SSL_HEADER is set automatically by the flag above.

# --- HTTPS hardening (all default to the safe value) -----------------
# SECURE_SSL_REDIRECT sends plain HTTP to HTTPS. Leave it true behind a proxy
# that terminates TLS *and* forwards X-Forwarded-Proto (above). Set false on a
# host that is only reachable over plain HTTP, or while testing with an IP.
# SECURE_SSL_REDIRECT=true
# HSTS: 30 days by default. 0 disables it (do that before the domain has a
# working certificate).
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Only after you have decided to submit the domain to the browser preload list.
# SECURE_HSTS_PRELOAD=false
# Paths that must answer even over plain HTTP (the platform's health probe).
# SECURE_REDIRECT_EXEMPT=^healthz$

# --- Health probe ---------------------------------------------------
# Point the host's health check at  /healthz          (process is up)
# or                          /healthz?db=1           (database reachable)
# Both are public, tiny, uncached and never write a session.

TIME_ZONE=Asia/Tehran

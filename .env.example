# ------------------------------------------------------------------
# Online Classroom — environment variables
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit the real .env file to version control.
# ------------------------------------------------------------------

# A long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# true for local development, false in production
DEBUG=true

# Leave empty to use SQLite (development).
# Production example (PostgreSQL):
#   DATABASE_URL=postgres://user:password@localhost:5432/online_classroom
DATABASE_URL=

# Leave empty to use the in-memory channel layer (development, single process).
# Production / multi-process example:
#   REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional
TIME_ZONE=UTC

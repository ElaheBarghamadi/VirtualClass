# ------------------------------------------------------------------
# Online Classroom — environment variables
#
# NOTHING IN THIS FILE IS REQUIRED.  The project boots on a bare server with
# no `.env` and no variables at all: SECRET_KEY is generated and kept in
# `private_media/.secret_key`, any Host header is accepted until you name your
# domain, cookies work over plain HTTP until you declare HTTPS, and
# DATABASE_URL / REDIS_URL are picked up from whatever the platform links.
# `python manage.py deploy_check` prints exactly what was decided.
#
# Use this file when you want to *fix* those defaults — a real domain, a real
# database, HTTPS.  Copy it to `.env` and adjust.  NEVER commit the real .env
# file to version control.
# ------------------------------------------------------------------

# ---- Everything below is optional; here is the short version ---------------
# For a real domain this is the whole configuration (see deploy/DEPLOY.md):
#   DEBUG=false
#   PUBLIC_URL=https://class.example.com        # adds ALLOWED_HOSTS + CSRF origin
#   HTTPS_IN_USE=true                           # Secure cookies + redirect + HSTS
#   DATABASE_URL=postgres://u:p@host:5432/db
#   REDIS_URL=redis://127.0.0.1:6379/0

# Optional.  Left empty (or left as the dev default) the app generates one and
# stores it in `private_media/.secret_key` with mode 0600, so sessions survive a
# restart.  Set it explicitly to share one key between several processes.
# SECRET_KEY=...

# true for local development, false on any server.  Booting with DEBUG=false and
# nothing else configured is legal (see the top of this file).
DEBUG=true

# Leave empty to use SQLite (development).
# Production example (PostgreSQL). A hosted DSN's query string (SSL, timeouts)
# and percent-encoded credentials are honoured:
#   DATABASE_URL=postgres://user:password@localhost:5432/online_classroom
#   DATABASE_URL=postgres://u:p%40ss@db.host:5432/db?sslmode=require
# DB_CONN_MAX_AGE=60                       # reuse connections (0 = per request)
# DB_DISABLE_SERVER_SIDE_CURSORS=true      # only with a transaction-pooling pgbouncer
# PythonAnywhere (MySQL — create it in the Databases tab):
#   DATABASE_URL=mysql://USERNAME:DBPASSWORD@USERNAME.mysql.pythonanywhere-services.com/USERNAME$default
DATABASE_URL=

# Leave empty to use the in-memory channel layer (development, single process).
# Production / multi-process example:
#   REDIS_URL=redis://127.0.0.1:6379/0
# Redis is the one dependency the whole real-time/queue stack shares: channel
# layer, cache, Celery broker and Celery result backend.  Empty = single-process
# development mode: in-memory layer, local-memory cache, and background jobs run
# inline (no worker needed).
REDIS_URL=

# ---- Background jobs (Celery) --------------------------------------
# Both default to REDIS_URL; override only for a separate broker.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Force inline execution (true) or force queueing (false); default:
# inline when REDIS_URL is empty, queued when it is set.
# CELERY_TASK_ALWAYS_EAGER=true
# Hard limit for one job, in seconds (default 600).
# CELERY_TASK_TIME_LIMIT=600

# ---- Housekeeping (run by `celery -A config beat`) ------------------
# End sessions left "in class" this long (hours, 0 disables). Default 8.
# STALE_SESSION_HOURS=8
# Delete guest memberships that left this many days ago (0 disables). Default 7.
# GUEST_RETENTION_DAYS=7
# `manage.py prune_history` windows: fold idle boards (days), drop old chat
# (days, 0 = keep forever).
# PRUNE_BOARD_DAYS=90
# PRUNE_CHAT_DAYS=0

# Comma-separated list of allowed hosts.
# Left unset, the app accepts any Host header (development, preview hosts, a LAN
# IP, or "some server I just deployed on") and reports deploy.W012 at boot so it
# cannot be mistaken for a finished configuration.  Setting this — or PUBLIC_URL
# below — narrows it to the names you actually use.  A literal `*` written here
# with DEBUG=false is still refused: name your domain instead.
# ALLOWED_HOSTS=class.example.com

# Comma-separated trusted origins for CSRF (production, https):
#   CSRF_TRUSTED_ORIGINS=https://classroom.example.com
# Not needed behind a proxy that sends X-Forwarded-Proto (see below).
CSRF_TRUSTED_ORIGINS=

# Trust the proxy's `X-Forwarded-Proto: https` header, so HTTPS Origins match
# behind a reverse proxy / preview proxy.  Default: on (proxy-hosted deployments
# would otherwise answer 403 to every form).
# TRUST_X_FORWARDED_PROTO=true

# Does this deployment really have TLS?  Default: yes when PUBLIC_URL is https,
# no otherwise.  Until then cookies are not `Secure` and HTTP is not redirected —
# which is what makes `http://server:8000` work.  Set true on a real domain.
# HTTPS_IN_USE=true

# ---- Media server (LiveKit SFU) -----------------------------------
# Leave all three empty to run without live media (chat + whiteboard
# still work).  NEVER expose the API key/secret to the browser —
# Django only issues short-lived scoped tokens.
MEDIA_SERVER_URL=
MEDIA_SERVER_API_KEY=
MEDIA_SERVER_API_SECRET=
# Token lifetime in minutes (default 360 = 6h)
MEDIA_TOKEN_TTL_MINUTES=360

# ---- Uploads -------------------------------------------------------
# Maximum upload size in megabytes (default 25)
MAX_UPLOAD_MB=25
# Per-user upload throttle: max N uploads per WINDOW seconds
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW=600

# Optional
TIME_ZONE=UTC

# --- WebRTC fallback mesh (cannot enforce removal of connected peers) --------
# Default: on when no LiveKit server is configured (otherwise the room would
# have no media at all), off as soon as MEDIA_SERVER_URL is set.
# MESH_ENABLED=1
# ICE servers for P2P mode. Public STUN alone fails behind strict NATs —
# run coturn (https://github.com/coturn/coturn) and list it here, e.g.:
# WEBRTC_ICE_SERVERS=[{"urls":["stun:turn.example.com:3478"]},{"urls":["turn:turn.example.com:3478?transport=udp"],"username":"classroom","credential":"CHANGE-ME"}]
WEBRTC_ICE_SERVERS=

# The mesh is O(n²); warn the host above this many active participants
MESH_MAX_PARTICIPANTS=12

# --- Email (password reset) -------------------------------------------------
# console = links print to the server console (development)
# smtp    = real email; fill the SMTP fields below
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

# Private classroom/assignment files: outside MEDIA_ROOT and all public web mappings.
# PRIVATE_MEDIA_ROOT=/absolute/path/outside/public/root

# --- Paths & static files (production) --------------------------------------
# /static/ is served by the app itself (WhiteNoise) from STATIC_ROOT.  Run
# `collectstatic` once with DEBUG=false (the image does it at build time); if
# nobody did, WhiteNoise falls back to the source directories so the page still
# has its CSS.  On a container platform point the two media roots at the
# persistent volume, e.g. /data/media.
# STATIC_ROOT=/srv/virtualclass/staticfiles
# MEDIA_ROOT=/srv/virtualclass/media
# Browser cache for /static/ in seconds (default: 3600 when DEBUG=false)
# WHITENOISE_MAX_AGE=3600

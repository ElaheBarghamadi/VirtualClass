# Copy to .env and fill in.  Never commit the real file.
# Generate a secret with:  python3 -c "import secrets; print(secrets.token_hex(16))"
TURN_SECRET=change-me-please

# Public hostname clients will connect to (used in the realm)
TURN_REALM=turn.example.com

# Public IP of THIS server.  Required when the host is behind NAT;
# leave empty when the host has a public IP directly on its interface.
TURN_EXTERNAL_IP=
